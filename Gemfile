source "https://rubygems.org"

# Local layouts do not need remote-theme downloads. The github-pages bundle
# pins jekyll-remote-theme to a version that requires vulnerable rubyzip 2.x.
gem "jekyll", "~> 3.10.0"
gem "kramdown-parser-gfm", "~> 1.1"
gem "webrick", "~> 1.9"
# Jekyll 3, Liquid and safe_yaml use libraries now separate gems on newer Ruby.
gem "base64", "~> 0.3"
gem "bigdecimal", "~> 4.1"
gem "logger", "~> 1.7"

group :jekyll_plugins do
  gem "jekyll-feed", "~> 0.17.0"
  gem "jekyll-paginate", "~> 1.1"
end
